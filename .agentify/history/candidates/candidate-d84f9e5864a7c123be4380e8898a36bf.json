      "invariants": [
        {
          "rule": "echo always flushes and strips ANSI sequences when the destination is not an interactive terminal unless color is forced.",
          "why": "Library callers rely on deterministic output across terminals, files, and captured streams.",
          "reference": "src/click/utils.py"
        },
        {
          "rule": "open_file wraps borrowed standard streams so context-manager exit does not close the caller-owned stream.",
          "why": "CLI applications commonly use '-' and must not invalidate process streams.",
          "reference": "src/click/utils.py"
        },
        {
          "rule": "Lazy and atomic writes preserve Click's FileError boundary and close-before-replace behavior.",
          "why": "Opening or replacing a file must report a Click error without leaking handles or masking the original failure.",
          "reference": "src/click/utils.py"
        },
        {
          "rule": "Filename formatting replaces invalid filesystem bytes or surrogates before UI output.",
          "why": "Strict output encodings must not fail merely while displaying a path.",
          "reference": "src/click/utils.py"
        }
      ],
      "pitfalls": [
        {
          "risk": "Closing a stream returned for '-' or treating a lazy wrapper as already open.",
          "consequence": "An embedding application's stdin/stdout can be closed or file errors move to the wrong phase.",
          "reference": "src/click/utils.py"
        },
        {
          "risk": "Writing bytes or ANSI text through an incompatible stream without the utility adapters.",
          "consequence": "Output is corrupted, raises an encoding error, or leaks styling into redirected output.",
          "reference": "src/click/utils.py"
        },
        {
          "risk": "Changing atomic or platform-specific open_stream behavior without testing ownership.",
          "consequence": "Temporary files remain or replacement fails on Windows and other supported platforms.",
          "reference": "tests/test_utils/test_open_file.py"
        }
      ],
      "entry_questions": [
        "Can output be bytes, contain ANSI, or target a non-tty?",
        "Does the path need lazy or atomic opening?",
        "Is the destination borrowed or owned by Click?",
        "Will an invalid filesystem name be displayed under strict encoding?"
