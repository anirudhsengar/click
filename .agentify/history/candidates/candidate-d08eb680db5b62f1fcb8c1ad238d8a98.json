      "invariants": [
        {
          "rule": "External pager/editor processes use argv lists and shell=False.",
          "why": "User-controlled environment values must not become shell commands.",
          "reference": "src/click/_termui_impl.py"
        },
        {
          "rule": "Pager writers never close borrowed streams.",
          "why": "CliRunner and embedding callers own those streams.",
          "reference": "src/click/_termui_impl.py"
        },
        {
          "rule": "Temporary pager files close before unlink.",
          "why": "Windows rejects unlinking open files and can mask the original error.",
          "reference": "src/click/_termui_impl.py"
        },
        {
          "rule": "Progress rendering differs between tty and non-tty/platform paths.",
          "why": "ANSI cursor controls are unsuitable for non-tty or legacy Windows output.",
          "reference": "src/click/_termui_impl.py"
        }
      ],
      "pitfalls": [
        {
          "risk": "Adding a platform branch without preserving pager/editor temp cleanup.",
          "consequence": "Windows PermissionError or leaked temporary files can replace the original failure.",
          "reference": "src/click/_termui_impl.py"
        },
        {
          "risk": "Bypassing render_finish when progress updates are below update_min_steps.",
          "consequence": "A completed progress bar can render below 100 percent.",
          "reference": "src/click/_termui_impl.py"
        },
        {
          "risk": "Assuming an editor or xdg-open exists in minimal environments.",
          "consequence": "External launch can fail with FileNotFoundError or a misleading success status.",
          "reference": "src/click/_termui_impl.py"
        }
