              "what_happens": "Pager/editor commands are tokenized into argv lists and launched with shell=False."
            },
            {
              "path": "src/click/utils.py",
              "what_happens": "echo and _LazyFile provide the stream writing and file-wrapper behavior used by terminal helpers."
            },
            {
              "path": "src/click/exceptions.py",
              "what_happens": "Terminal process and user-input failures use ClickException or Abort for consistent reporting."
            },
            {
              "path": "src/click/_termui_impl.py",
              "what_happens": "Temporary files and borrowed streams are flushed, closed, or unlinked according to platform lifecycle rules."
